# Copy to .env for local use. On hosts, set these in the dashboard instead — never commit real values.

# ---------- API host (Render / Railway / VPS) ----------
AUTH_SECRET=                 # long random string (openssl rand -hex 32). REQUIRED in production.
ADMIN_EMAIL=owner@yourdomain.in
ADMIN_PASSWORD=              # first admin password, used on first boot only. REQUIRED in production.
PUBLIC_SITE_URL=https://www.oakandline.in   # public website address, used in sitemap.xml
DATABASE_PATH=/var/data/oakline.db          # must be on a persistent disk
UPLOAD_DIR=/var/data/uploads                # must be on a persistent disk
SEED_DEMO_PROJECTS=true      # false = start with an empty portfolio
TRUST_PROXY=true             # real visitor IPs behind Render/Netlify (rate limiting)
PORT=5000
CORS_ORIGIN=                 # only if the website calls the API directly (VITE_API_URL)

# ---------- Netlify (website) ----------
API_ORIGIN=https://oakline-api.onrender.com  # the API host above — Netlify proxies /api and /uploads to it
VITE_ROUTER=browser          # clean URLs (/work). Already set in netlify.toml
VITE_API_URL=                # leave empty (proxy is used)
