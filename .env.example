# Copy to .env for local use. On hosts, set these in the dashboard instead — never commit real values.

# ---------- Netlify site + serverless API ----------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=    # Supabase server-only secret; never put this in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=       # public anon/publishable key; safe in the frontend bundle.
AUTH_SECRET=                  # generate a private random value, e.g. openssl rand -hex 32.
ADMIN_EMAIL=owner@yourdomain.in
ADMIN_PASSWORD=               # strong first admin password; used only to seed an empty database.
PUBLIC_SITE_URL=https://your-site.netlify.app
SEED_DEMO_PROJECTS=false      # use true to add the sample portfolio on the first API request.
VITE_ROUTER=browser           # already set by netlify.toml
